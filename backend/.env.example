# WildWatch Backend Configuration

PROJECT_NAME=WildWatch
API_V1_STR=/api/v1
ENVIRONMENT=development

# Database Configuration (Defaults to SQLite for local development; can use PostgreSQL)
DATABASE_URL=sqlite:///./wildwatch.db
# PostgreSQL Example:
# DATABASE_URL=postgresql://wildwatch:password@localhost:5432/wildwatch_db

# CORS Allowed Origins
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Model Configuration
DEFAULT_CONFIDENCE_FLOOR=0.70
AUTO_VERIFY_THRESHOLD=0.90
DUPLICATE_WINDOW_MINUTES=15
MODEL_WEIGHTS_PATH=models/yolov8n.pt
